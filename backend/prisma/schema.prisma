generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SUPPLIER_ADMIN
  SUPPLIER_STAFF
  OPERATOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum SupplierStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TourStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PriceComponentType {
  BASE
  ADDON
  TAX
  FEE
  DISCOUNT
}

enum InventoryMode {
  SHARED
  PER_OPTION
  PER_DEPARTURE
}

enum DepartureSlotStatus {
  ACTIVE
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  INITIATED
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_OPERATOR
  EXPIRED
  REFUNDED_PARTIAL
  REFUNDED_FULL
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum ReviewReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

enum PromoType {
  PERCENT
  FIXED_AMOUNT
}

enum PromoScope {
  GLOBAL
  SUPPLIER
  TOUR
  OPTION
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum BlogPostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ConversationType {
  SUPPORT
  BOOKING
  SUPPLIER_CUSTOMER
  SYSTEM
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
  SPAM
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
  FILE
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Country {
  id           String   @id @default(uuid()) @db.Uuid
  iso2         String   @unique @db.Char(2)
  iso3         String   @unique @db.Char(3)
  name         String
  currencyCode String   @db.Char(3)
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("countries")
}

model CountryTranslation {
  countryId    String   @db.Uuid
  languageCode String   @db.VarChar(10)
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([countryId, languageCode])
  @@map("country_translations")
}

model City {
  id             String   @id @default(uuid()) @db.Uuid
  countryId      String   @db.Uuid
  name           String
  normalizedName String
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  timezone       String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([countryId, normalizedName])
  @@index([normalizedName])
  @@map("cities")
}

model CityTranslation {
  cityId       String   @db.Uuid
  languageCode String   @db.VarChar(10)
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([cityId, languageCode])
  @@map("city_translations")
}

model Language {
  code String @id @db.VarChar(10)
  name String

  @@map("languages")
}

model Currency {
  code     String @id @db.Char(3)
  name     String
  symbol   String?
  decimals Int    @default(2)

  @@map("currencies")
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  rate          Decimal  @db.Decimal(20, 10)
  effectiveAt   DateTime
  createdAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, effectiveAt])
  @@map("exchange_rates")
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  phoneE164       String?
  countryId       String?              @db.Uuid
  displayCountry  String?
  status          UserStatus           @default(PENDING)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  roles           UserRoleAssignment[]
  sessions        UserSession[]
  passwordResets  PasswordResetToken[]
  bookings        Booking[]
  reviews         Review[]

  @@index([status])
  @@map("users")
}

model UserRoleAssignment {
  userId     String   @db.Uuid
  role       UserRole
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model UserOAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  providerUserId String
  metadata       Json
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@map("user_oauth_accounts")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
  @@map("password_reset_tokens")
}

model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  legalName   String
  displayName String
  slug        String         @unique
  email       String?
  phoneE164   String?
  countryId   String?        @db.Uuid
  cityId      String?        @db.Uuid
  addressLine String?
  taxId       String?
  status      SupplierStatus @default(PENDING)
  ratingAvg   Decimal?       @db.Decimal(3, 2)
  ratingCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("suppliers")
}

model SupplierUser {
  supplierId String   @db.Uuid
  userId     String   @db.Uuid
  role       UserRole
  createdAt  DateTime @default(now())

  @@id([supplierId, userId, role])
  @@map("supplier_users")
}

model SupplierSettlement {
  id                String       @id @default(uuid()) @db.Uuid
  supplierId        String       @db.Uuid
  currencyCode      String       @db.Char(3)
  periodStart       DateTime     @db.Date
  periodEnd         DateTime     @db.Date
  grossAmount       Decimal      @default(0) @db.Decimal(14, 2)
  platformFeeAmount Decimal      @default(0) @db.Decimal(14, 2)
  netAmount         Decimal      @default(0) @db.Decimal(14, 2)
  payoutStatus      PayoutStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime     @default(now())

  @@map("supplier_settlements")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model CategoryTranslation {
  categoryId   String   @db.Uuid
  languageCode String   @db.VarChar(10)
  name         String
  description  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([categoryId, languageCode])
  @@map("category_translations")
}

model Tour {
  id                 String        @id @default(uuid()) @db.Uuid
  supplierId         String        @db.Uuid
  cityId             String        @db.Uuid
  slug               String        @unique
  title              String
  shortDescription   String?
  fullDescription    String?
  meetingPoint       String?
  latitude           Decimal?      @db.Decimal(9, 6)
  longitude          Decimal?      @db.Decimal(9, 6)
  durationMinutes    Int?
  maxGroupSize       Int?
  status             TourStatus    @default(DRAFT)
  inventoryMode      InventoryMode @default(PER_DEPARTURE)
  cancellationPolicy Json          @default("{}")
  includedItems      Json          @default("[]")
  excludedItems      Json          @default("[]")
  highlights         Json          @default("[]")
  whatToBring        Json          @default("[]")
  importantInfo      Json          @default("[]")
  availableLanguages String[]      @default([])
  isFeatured         Boolean       @default(false)
  badgeText          String?
  defaultLanguageCode String?       @db.VarChar(10)
  allowPayLater      Boolean       @default(false)
  ratingAvg          Decimal?      @db.Decimal(3, 2)
  ratingCount        Int           @default(0)
  ratingGuideAvg     Decimal?      @db.Decimal(3, 2)
  ratingTransportAvg Decimal?      @db.Decimal(3, 2)
  ratingValueAvg     Decimal?      @db.Decimal(3, 2)
  bookingCount       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  publishedAt        DateTime?

  reviews Review[]

  @@index([cityId, status])
  @@index([supplierId, status])
  @@map("tours")
}

model TourTranslation {
  tourId            String   @db.Uuid
  languageCode      String   @db.VarChar(10)
  title             String
  shortDescription  String?
  fullDescription   String?
  includedItems     Json?
  excludedItems     Json?
  highlights        Json?
  whatToBring       Json?
  importantInfo     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([tourId, languageCode])
  @@map("tour_translations")
}

model TourCategory {
  tourId     String @db.Uuid
  categoryId String @db.Uuid

  @@id([tourId, categoryId])
  @@map("tour_categories")
}

model TourMedia {
  id        String    @id @default(uuid()) @db.Uuid
  tourId    String    @db.Uuid
  mediaType MediaType
  url       String
  altText   String?
  sortOrder Int       @default(0)
  isCover   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([tourId, sortOrder])
  @@map("tour_media")
}

model TourTag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  @@map("tour_tags")
}

model TourTagTranslation {
  tagId        String   @db.Uuid
  languageCode String   @db.VarChar(10)
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([tagId, languageCode])
  @@map("tour_tag_translations")
}

model TourTagMap {
  tourId String @db.Uuid
  tagId  String @db.Uuid

  @@id([tourId, tagId])
  @@map("tour_tag_map")
}

model TourItineraryStop {
  id              String   @id @default(uuid()) @db.Uuid
  tourId          String   @db.Uuid
  stopOrder       Int
  title           String
  description     String?
  durationMinutes Int?
  transportMode   String?
  transportDurationMinutes Int?
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tourId, stopOrder])
  @@index([tourId])
  @@map("tour_itinerary_stops")
}

model TourItineraryStopTranslation {
  stopId       String   @db.Uuid
  languageCode String   @db.VarChar(10)
  title        String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([stopId, languageCode])
  @@map("tour_itinerary_stop_translations")
}

model TourOption {
  id              String   @id @default(uuid()) @db.Uuid
  tourId          String   @db.Uuid
  code            String
  title           String
  description     String?
  isDefault       Boolean  @default(false)
  minParticipants Int      @default(1)
  maxParticipants Int?
  durationMinutes Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tourId, code])
  @@index([tourId, isActive])
  @@map("tour_options")
}

model TourOptionTranslation {
  tourOptionId String   @db.Uuid
  languageCode String   @db.VarChar(10)
  title        String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([tourOptionId, languageCode])
  @@map("tour_option_translations")
}

model OptionPricingRule {
  id            String             @id @default(uuid()) @db.Uuid
  tourOptionId  String             @db.Uuid
  componentType PriceComponentType @default(BASE)
  travelerType  String             @default("adult")
  currencyCode  String             @db.Char(3)
  amount        Decimal            @db.Decimal(12, 2)
  validFrom     DateTime
  validTo       DateTime?
  daysOfWeek    Int[]              @default([1, 2, 3, 4, 5, 6, 7])
  minQuantity   Int                @default(1)
  createdAt     DateTime           @default(now())

  @@index([tourOptionId, travelerType, validFrom, validTo])
  @@map("option_pricing_rules")
}

model DepartureSlot {
  id           String              @id @default(uuid()) @db.Uuid
  tourOptionId String              @db.Uuid
  startsAt     DateTime
  endsAt       DateTime?
  timezone     String?
  status       DepartureSlotStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tourOptionId, startsAt])
  @@index([startsAt])
  @@map("departure_slots")
}

model InventorySlot {
  id              String   @id @default(uuid()) @db.Uuid
  departureSlotId String   @unique @db.Uuid
  totalCapacity   Int
  heldCapacity    Int      @default(0)
  bookedCapacity  Int      @default(0)
  oversellLimit   Int      @default(0)
  version         BigInt   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("inventory_slots")
}

model InventoryHold {
  id              String   @id @default(uuid()) @db.Uuid
  inventorySlotId String   @db.Uuid
  bookingId       String?  @db.Uuid
  quantity        Int
  expiresAt       DateTime
  releasedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([inventorySlotId, expiresAt])
  @@map("inventory_holds")
}

model BookingCart {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  currencyCode String   @db.Char(3)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("booking_carts")
}

model BookingCartItem {
  id              String   @id @default(uuid()) @db.Uuid
  cartId          String   @db.Uuid
  departureSlotId String   @db.Uuid
  travelerMix     Json     @default("[]")
  languageCode    String?  @db.VarChar(10)
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  addedAt         DateTime @default(now())

  @@map("booking_cart_items")
}

model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  bookingRef        String        @unique
  userId            String?       @db.Uuid
  supplierId        String?       @db.Uuid
  status            BookingStatus @default(INITIATED)
  currencyCode      String        @db.Char(3)
  subtotalAmount    Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(14, 2)
  feeAmount         Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount       Decimal       @default(0) @db.Decimal(14, 2)
  contactEmail      String?
  contactPhoneE164  String?
  notes             String?
  cancellationReason String?
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  expiresAt         DateTime?
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User?         @relation(fields: [userId], references: [id])
  items             BookingItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([supplierId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("bookings")
}

model BookingItem {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @db.Uuid
  tourId           String   @db.Uuid
  tourOptionId     String   @db.Uuid
  departureSlotId  String   @db.Uuid
  inventorySlotId  String?  @db.Uuid
  titleSnapshot    String
  optionSnapshot   String?
  startsAtSnapshot DateTime
  travelerMix      Json     @default("[]")
  languageCode     String?  @db.VarChar(10)
  quantity         Int
  unitPrice        Decimal  @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  booking          Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([departureSlotId])
  @@map("booking_items")
}

model BookingTraveler {
  id            String   @id @default(uuid()) @db.Uuid
  bookingItemId String   @db.Uuid
  travelerType  String
  firstName     String?
  lastName      String?
  birthDate     DateTime? @db.Date
  nationality   String?   @db.Char(2)
  passportNumber String?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())

  @@map("booking_travelers")
}

model BookingEvent {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  eventType String
  payload   Json     @default("{}")
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt(sort: Desc)])
  @@map("booking_events")
}

model BookingVoucher {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @unique @db.Uuid
  voucherCode String   @unique
  qrPayload   String?
  issuedAt    DateTime @default(now())
  redeemedAt  DateTime?

  @@map("booking_vouchers")
}

model PaymentMethod {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @db.Uuid
  provider         String
  providerMethodId String
  methodType       String?
  brand            String?
  last4            String?
  expMonth         Int?
  expYear          Int?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())

  @@unique([provider, providerMethodId])
  @@map("payment_methods")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @db.Uuid
  paymentMethodId   String?       @db.Uuid
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(CREATED)
  currencyCode      String        @db.Char(3)
  amount            Decimal       @db.Decimal(14, 2)
  authorizedAmount  Decimal       @default(0) @db.Decimal(14, 2)
  capturedAmount    Decimal       @default(0) @db.Decimal(14, 2)
  refundedAmount    Decimal       @default(0) @db.Decimal(14, 2)
  failureCode       String?
  failureMessage    String?
  idempotencyKey    String?       @unique
  metadata          Json          @default("{}")
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([bookingId, createdAt(sort: Desc)])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  eventType       String
  status          WebhookEventStatus @default(RECEIVED)
  payload         Json
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  errorMessage    String?

  @@unique([provider, providerEventId])
  @@map("payment_webhook_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  bookingId        String       @db.Uuid
  providerRefundId String?      @unique
  status           RefundStatus @default(REQUESTED)
  currencyCode     String       @db.Char(3)
  amount           Decimal      @db.Decimal(14, 2)
  reason           String?
  metadata         Json         @default("{}")
  createdBy        String?      @db.Uuid
  requestedAt      DateTime     @default(now())
  completedAt      DateTime?

  @@index([bookingId, requestedAt(sort: Desc)])
  @@map("refunds")
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @db.Uuid
  invoiceNumber  String   @unique
  buyerName      String?
  buyerTaxId     String?
  billingAddress String?
  currencyCode   String   @db.Char(3)
  subtotalAmount Decimal  @db.Decimal(14, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal  @db.Decimal(14, 2)
  issuedAt       DateTime @default(now())
  pdfUrl         String?

  @@map("invoices")
}

model Promotion {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  name              String
  promoType         PromoType
  promoScope        PromoScope
  value             Decimal   @db.Decimal(12, 2)
  maxDiscountAmount Decimal?  @db.Decimal(12, 2)
  minOrderAmount    Decimal?  @default(0) @db.Decimal(12, 2)
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  startsAt          DateTime
  endsAt            DateTime?
  isActive          Boolean   @default(true)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("promotions")
}

model PromotionScopeEntry {
  id           String   @id @default(uuid()) @db.Uuid
  promotionId  String   @db.Uuid
  supplierId   String?  @db.Uuid
  tourId       String?  @db.Uuid
  tourOptionId String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@map("promotion_scopes")
}

model PromotionRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  promotionId    String   @db.Uuid
  bookingId      String   @db.Uuid
  userId         String?  @db.Uuid
  discountAmount Decimal  @db.Decimal(12, 2)
  redeemedAt     DateTime @default(now())

  @@unique([promotionId, bookingId])
  @@index([promotionId, userId])
  @@map("promotion_redemptions")
}

model Review {
  id              String       @id @default(uuid()) @db.Uuid
  tourId          String       @db.Uuid
  bookingId       String?      @db.Uuid
  userId          String?      @db.Uuid
  rating          Int
  ratingGuide     Int?
  ratingTransport Int?
  ratingValue     Int?
  title           String?
  body            String?
  languageCode    String?      @db.VarChar(10)
  status          ReviewStatus @default(PENDING)
  verifiedBooking Boolean      @default(false)
  helpfulCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tour Tour  @relation(fields: [tourId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@index([tourId, status, createdAt(sort: Desc)])
  @@map("reviews")
}

model ReviewMedia {
  id        String    @id @default(uuid()) @db.Uuid
  reviewId  String    @db.Uuid
  mediaType MediaType
  url       String
  createdAt DateTime  @default(now())

  @@map("review_media")
}

model ReviewVote {
